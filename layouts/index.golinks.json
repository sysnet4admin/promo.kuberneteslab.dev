{{- /* /go/<이름> 함수가 읽는 행사 링크 목록. history.yaml에서 link가 /go/로 시작하는 항목만 담는다.
     함수는 종료 시각이 지난 슬러그에 "끝났습니다" 안내를 보인다. */ -}}
{{- $out := slice -}}
{{- range hugo.Data.promo.history.promos -}}
  {{- $p := . -}}
  {{- with $p.link -}}
    {{- if hasPrefix . "/go/" -}}
      {{- $out = $out | append (dict "slug" (strings.TrimPrefix "/go/" .) "name" $p.name "end" ((time.AsTime $p.end).Format "2006-01-02T15:04:05Z07:00")) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{ $out | jsonify (dict "indent" "  ") }}
